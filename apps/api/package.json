    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "pino": "9.9.5",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.1.4",
    "tsx": "4.20.5"
